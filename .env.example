# ─────────────────────────────────────────────────────────────────────────────
# Qanoon Assist — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django core ───────────────────────────────────────────────────────────────

# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production; True only for local development
DEBUG=True

# Comma-separated list of allowed hostnames (no spaces)
# Local:      127.0.0.1,localhost
# Production: qanoon-assist-api.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ──────────────────────────────────────────────────────────────────

# --- Local development (used by settings.py) ---
DB_NAME=qanoon_assist
DB_USER=qanoon_user
DB_PASSWORD=your-local-db-password
DB_HOST=localhost
DB_PORT=5432

# --- Production (used by settings_prod.py — overrides the above) ---
# Supabase → Project Settings → Database → Connection string (URI mode)
# Format: postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to False only if your database does not support SSL (e.g. local dev via DATABASE_URL)
DATABASE_SSL_REQUIRE=True

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (no spaces, no trailing slash)
# Local:      http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
# These are read in settings.py via SIMPLE_JWT.
# Override here if you need non-default values.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
